<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XuanFeng Browser"
        android:textSize="28sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="崩溃"
        android:textSize="48sp"
        android:textColor="#FF4444"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="也许你遇到了一些棘手问题"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="30dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="如果重启不能解决或多次发生，请联系我反馈，QQ:473450426"
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_marginTop="5dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="30dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp"
        android:background="#FFFFFF"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="log: 正在收集..."
            android:textSize="12sp"
            android:textColor="#333333"
            android:fontFamily="monospace" />

    </ScrollView>

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="error: "
        android:textSize="12sp"
        android:textColor="#FF4444"
        android:fontFamily="monospace"
        android:layout_marginTop="5dp" />

    <TextView
        android:id="@+id/tv_process"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Error process: "
        android:textSize="12sp"
        android:textColor="#666666"
        android:fontFamily="monospace"
        android:layout_marginTop="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp">

        <ImageButton
            android:id="@+id/btn_export"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:src="@drawable/ic_export"
            android:scaleType="center"
            android:background="#4CAF50"
            android:layout_marginRight="5dp"
            android:contentDescription="导出日志" />

        <ImageButton
            android:id="@+id/btn_restart"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:src="@drawable/ic_restart"
            android:scaleType="center"
            android:background="@color/xf_primary"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:contentDescription="重启应用" />

        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:src="@drawable/ic_exit"
            android:scaleType="center"
            android:background="@color/xf_error"
            android:layout_marginLeft="5dp"
            android:contentDescription="关闭应用" />

    </LinearLayout>

</LinearLayout>